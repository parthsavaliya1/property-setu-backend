# PostgreSQL (required)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:your-database-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=change-this-to-a-long-random-string

NODE_ENV=development

# Bunny storage. Set these on the API only. Do not put them in the mobile app.
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_API_KEY=your-storage-password
BUNNY_CDN_BASE_URL=https://your-pull-zone.b-cdn.net

# Image and video compression. Restart the API after changing these.
MEDIA_IMAGE_MAX_EDGE=640
MEDIA_IMAGE_TARGET_BYTES=40960
MEDIA_IMAGE_JPEG_QUALITY=70
MEDIA_VIDEO_MAX_EDGE=480
MEDIA_VIDEO_TARGET_BYTES=1572864
MEDIA_VIDEO_CRF=32
MEDIA_VIDEO_AUDIO_BITRATE=64k

# Razorpay. Create these under Account & Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Listing charges and the premium offer are set in the admin Settings tab.
# Until that migration runs, the API uses ₹20 standard and ₹30 premium.

# 2Factor OTP. Same key as VADI Hisab. The key stays on the API.
TWO_FACTOR_API_KEY=your-2factor-api-key

# Gemini reads a property poster and fills the listing form. Create a key at https://aistudio.google.com/apikey
# The key stays on the API. Do not put it in the mobile app.
GEMINI_API_KEY=

# Required public contact for privacy, terms and deletion assistance.
SUPPORT_EMAIL=

# Server-only Google Play Developer API credentials. Never EXPO_PUBLIC_ these.
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=

# Strong random secret used by the protected Vercel maintenance cron.
CRON_SECRET=

# Optional dedicated review login. No hardcoded reviewer account is enabled.
# Keep this account separate from real users and administrators.
PLAY_REVIEW_PHONE=
PLAY_REVIEW_OTP=
