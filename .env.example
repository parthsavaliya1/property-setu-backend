# PostgreSQL (required)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:your-database-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# JWT
JWT_SECRET=change-this-to-a-long-random-string

# Optional
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:8081,http://localhost:19006

# Bunny storage. Set these on the API only. Do not put them in the mobile app.
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_API_KEY=your-storage-password
BUNNY_CDN_BASE_URL=https://your-pull-zone.b-cdn.net
BUNNY_UPLOAD_PREFIX=property
# Leave empty for the main storage endpoint. Set sg, ny, or la only if the zone was created in that region.
BUNNY_STORAGE_REGION=

# Image and video compression. Restart the API after changing these.
MEDIA_IMAGE_MAX_EDGE=640
MEDIA_IMAGE_TARGET_BYTES=40960
MEDIA_IMAGE_JPEG_QUALITY=70
MEDIA_VIDEO_MAX_EDGE=480
MEDIA_VIDEO_TARGET_BYTES=1572864
MEDIA_VIDEO_CRF=32
MEDIA_VIDEO_AUDIO_BITRATE=64k

# Razorpay. Create these under Account & Settings → API Keys.
# The Key Secret stays on the API. Do not put it in the mobile app.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Listing charges are read from Firebase Remote Config (vadi-hisab), same keys as the app:
# custom_property_price and premium_property_price. No extra env value is required.

# 2Factor OTP. Same key as VADI Hisab. The key stays on the API.
TWO_FACTOR_API_KEY=your-2factor-api-key
# sms (default) or voice
OTP_CHANNEL=sms

# Resend sends the signup verification link. Verify a domain at https://resend.com/domains.
# onboarding@resend.dev only delivers to the email address on the Resend account.
RESEND_API_KEY=re_your_key
RESEND_FROM=PropertySetu <noreply@yourdomain.com>

# Public address of this API, used inside the verification link.
# Example: https://api.yourdomain.com or http://192.168.1.10:4000
# Leave empty to use the host the app called.
API_PUBLIC_URL=

# Google sign-in. Create a Web client at https://console.cloud.google.com/apis/credentials
# The secret stays on the API. The app only gets the client ID.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-client-secret
# Optional phone clients. These have no secret.
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# Gemini reads a property poster and fills the listing form. Create a key at https://aistudio.google.com/apikey
# The key stays on the API. Do not put it in the mobile app.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash, the same model as vadi-hisab crop doctor.
# GEMINI_MODEL=gemini-3.6-flash
